{
  "name": "job-mark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@noble/hashes": "^1.8.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "classic-level": "^3.0.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^24.43.1",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.jobmark.app",
    "productName": "JobMark",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "JobMark.exe"
    }
  },
  "overrides": {
    "@noble/hashes": "^1.8.0"
  },
  "description": "本地优先的求职投递记录与流程跟踪工具（看板 / Electron 桌面版）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilezi999111-gif/job-mark-app.git"
  }
}